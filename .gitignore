# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Variantes sem o ponto inicial: ".env*" nao as cobre. A pasta de trabalho
# costuma ter um "env.local" com SUPABASE_SERVICE_ROLE_KEY e
# POWERBI_CLIENT_SECRET, que ficaria como untracked e poderia ser commitado.
# Padroes propositalmente estreitos para nao engolir arquivos de codigo
# legitimos como env.ts / env.mjs / env.d.ts.
env.local
env.local.*
env.*.local
*.env
debug_*.txt
scripts/

# supabase (migrations contain schema internals)
/supabase

# temp files
temp_*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
